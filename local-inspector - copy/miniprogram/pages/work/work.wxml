<view class="page">
 <view class="title">质量安全小察</view><view class="muted">{{user.name}} · 采集、确认、简报上报</view>
 <view wx:if="{{busy}}" class="note">正在处理，请稍候…</view>
 <block wx:if="{{view==='list'}}">
  <view class="note">可执行平台派发的任务，也可在有检查权限的项目自主发起临时巡查。上报后，由网页平台接收并办理整改、复核及正式报告。</view>
  <button wx:if="{{canInitiate}}" class="actions" bindtap="newAdhoc" disabled="{{busy}}">＋ 发起临时巡查</button>
  <button class="secondary actions" bindtap="reload" disabled="{{busy}}">刷新任务与平台反馈</button>
  <view class="card" wx:if="{{reminders.length}}"><view class="h2 warning">任务提醒</view><view wx:for="{{reminders}}" wx:key="text" data-id="{{item.taskId}}" bindtap="open">{{item.text}} →</view></view>
  <view class="card" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="tag">{{item.sourceName}} · {{item.statusName}} · {{item.fieldStatusName}}</view><view class="h2">{{item.title}}</view><view>{{item.number}}</view><view class="muted">{{item.scenario.name}} · 截止 {{item.dueDate}}</view><view>{{item.issues.length}} 条隐患记录 →</view></view>
  <view wx:if="{{!tasks.length}}" class="empty">{{canInitiate?'暂无任务，可以自主发起临时巡查，无需等待平台派单。':'暂无任务，请联系平台负责人分配项目检查权限。'}}</view>
 </block>
 <block wx:elif="{{view==='create'}}">
  <button class="secondary small" bindtap="back">返回任务列表</button>
  <view class="card"><view class="h2">发起临时巡查</view><view class="note">由你作为执行人，无需平台预先派单。准备清单确认后即可登记隐患，成果接收人由平台后续指定。</view>
   <view class="label">所属合同</view><picker range="{{eligibleProjects}}" range-key="contractLabel" value="{{adhocProjectIndex}}" bindchange="adhocProjectPick"><view class="picker">{{eligibleProjects[adhocProjectIndex].contractLabel}} ▾</view></picker>
   <view class="label">检查场景</view><picker range="{{scenarios}}" range-key="name" value="{{scenarioIndex}}" bindchange="adhocScenarioPick"><view class="picker">{{scenarios[scenarioIndex].name}} ▾</view></picker>
   <view class="label">巡查名称</view><input maxlength="200" value="{{newTask.title}}" data-key="newTask.title" bindinput="input"/>
   <view class="label">检查人员名单</view><input maxlength="1000" placeholder="多人用逗号分隔，例如：张三、李四" value="{{newTask.inspectors}}" data-key="newTask.inspectors" bindinput="input"/><view class="label">检查对象／设备（选填）</view><input maxlength="200" placeholder="例如二号楼或设备名称" value="{{newTask.object}}" data-key="newTask.object" bindinput="input"/>
   <view class="label">预计完成日期</view><picker mode="date" value="{{newTask.dueDate}}" data-key="newTask.dueDate" bindchange="input"><view class="picker">{{newTask.dueDate}} ▾</view></picker>
   <view wx:for="{{scenarios[scenarioIndex].fields}}" wx:key="*this"><view class="label">{{item}}{{(scenarios[scenarioIndex].id==='inspection' && (item==='检查区域' || item==='检查重点')) || (scenarios[scenarioIndex].id==='handover' && (item==='设备编号' || item==='验收范围'))?'（选填）':''}}</view><input maxlength="1000" value="{{fieldValues[item]}}" data-key="{{item}}" bindinput="adhocField"/></view>
   <button class="actions" bindtap="createAdhoc" disabled="{{busy}}">建立临时巡查并进入现场准备</button>
  </view>
 </block>
 <block wx:elif="{{view==='brief'}}">
  <button class="secondary small" bindtap="closeBrief">返回任务</button>
  <view class="card"><view class="tag">现场上报材料 · 非正式审核报告</view><view class="h2">现场检查简报 v{{brief.version}}</view><view>{{brief.task.title}} · {{brief.task.number}}</view><view>项目：{{brief.project.name}}</view><view>对象：{{brief.task.object}}</view><view>检查人员：{{brief.task.inspectors}}</view><view>摘要：{{brief.task.fieldSummary}}</view><button wx:if="{{brief.task.fieldSignature}}" class="secondary small" data-id="{{brief.task.fieldSignature.evidenceId}}" bindtap="viewEvidence">查看签名：{{brief.task.fieldSignature.name}}</button><view>上报时间：{{brief.exportedAt}}</view></view>
  <view class="card" wx:for="{{brief.task.records}}" wx:key="id"><view class="h2">{{item.type}} · {{item.authorName}}</view><view class="text">{{item.text}}</view><view class="muted">实际发生 {{item.occurredAt}}</view><view class="muted">上传 {{item.uploadedAt}}</view></view>
  <view class="card"><view class="h2">发现的问题（{{brief.task.issues.length}}）</view><view class="record" wx:for="{{brief.task.issues}}" wx:key="id"><view>{{item.category}} · {{item.location}} · {{item.risk}}风险</view><view>{{item.description}}</view><view wx:if="{{item.reference}}">依据：{{item.reference}}</view><view wx:if="{{item.suggestion}}">建议：{{item.suggestion}}</view><button wx:for="{{item.evidence}}" wx:for-item="eid" wx:key="*this" class="small secondary" data-id="{{eid}}" bindtap="viewEvidence">查看本条隐患证据</button></view></view>
  <view class="card"><view class="h2">现场证据</view><button class="small secondary actions" wx:for="{{brief.evidence}}" wx:key="id" data-id="{{item.id}}" data-mime="{{item.mime}}" bindtap="viewEvidence">{{item.name}} · 查看／播放</button></view>
  <button class="actions" data-id="{{briefId}}" bindtap="briefWord" disabled="{{busy}}">预览／分享简报 Word</button>
 </block>
 <block wx:else>
  <button class="secondary small" bindtap="back">返回任务列表</button>
  <view class="card"><view class="tag">{{task.sourceName}} · {{task.statusName}} · {{task.fieldStatusName}}</view><view class="h2">{{task.title}}</view><view>{{task.number}}</view><view>对象：{{task.object}}</view><view>执行人：{{task.assigneeName}} · 期限：{{task.dueDate}}</view><view class="muted">场景 {{task.scenario.name}} v{{task.scenario.version}} · 数据修订 {{task.revision}}</view>
   <view class="note" wx:if="{{task.fieldFeedback}}">平台反馈：{{task.fieldFeedback.text}}</view>
   <view wx:if="{{task.status==='ready'&&canWrite}}"><checkbox-group bindchange="checks"><label wx:for="{{task.scenario.checklist}}" wx:key="*this"><checkbox value="{{item}}"/>{{item}}</label></checkbox-group><button bindtap="start" disabled="{{busy}}">确认准备完毕并开始</button></view>
   <view class="h2">任务资料</view><button wx:for="{{task.materials}}" wx:key="*this" class="small secondary actions" data-id="{{item}}" bindtap="viewEvidence">查看任务资料</button><view wx:if="{{!task.materials.length}}" class="muted">暂无附件资料</view>
  </view>
  <view class="card"><view class="h2">已保存隐患（{{task.issues.length}}）</view><view class="record" wx:for="{{task.issues}}" wx:key="id"><view class="row between" data-id="{{item.id}}" bindtap="toggleIssue"><view>隐患记录（{{index+1}}）</view><view class="muted">{{expandedIssueId===item.id?'收起 ▴':'展开 ▾'}}</view></view><block wx:if="{{expandedIssueId===item.id}}"><view class="tag">{{item.statusName}} · {{item.risk}}</view><view class="h2">{{item.category || '现场问题'}} · {{item.location}}</view><view>{{item.subcategory}}</view><view class="text">{{item.description}}</view><view wx:if="{{item.reference}}" class="text">依据：{{item.reference}}</view><view wx:if="{{item.suggestion}}" class="text">建议：{{item.suggestion}}</view><view class="muted">整改：{{item.assigneeName}} · 复核：{{item.reviewerName}}</view><view class="actions"><button class="small secondary" wx:for="{{item.evidence}}" wx:for-item="eid" wx:key="*this" data-id="{{eid}}" bindtap="viewEvidence">证据</button></view></block></view></view>
  <view wx:if="{{canCollect}}" class="field-nav"><button class="secondary small" data-section="issue-form" bindtap="jump">隐患登记 / 拍照</button><button class="secondary small" data-section="brief-form" bindtap="jump">简报上报</button></view>  <view id="issue-form" class="card issue-card" wx:if="{{canCollect}}">
   <view class="row between"><view class="h2">隐患记录（{{task.issues.length+1}}）</view><view class="tag">第 {{task.issues.length+1}} 条</view></view>
   <view class="muted">逐条填写、拍照和保存，照片只关联当前隐患。</view>
   <view class="label">隐患类别</view><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="categoryPick"><view class="picker">{{issue.category}} ▾</view></picker>
   <view class="label">子分类</view><input placeholder="例如：临边防护、混凝土质量" maxlength="200" value="{{issue.subcategory}}" data-key="issue.subcategory" bindinput="input"/>
   <view class="label">具体部位（选填）</view><input placeholder="可填写楼栋、楼层、轴线或设备位置" maxlength="500" value="{{issue.location}}" data-key="issue.location" bindinput="input"/>
   <view class="label">隐患描述 *</view><textarea maxlength="4000" placeholder="描述现场现象、存在问题及可能影响" value="{{issue.description}}" data-key="issue.description" bindinput="input"/>
   <view class="label">隐患风险等级 *</view><picker range="{{risks}}" value="{{riskIndex}}" bindchange="riskPick"><view class="picker risk-{{riskIndex}}">{{risks[riskIndex]}}风险 · 点击选择 ▾</view></picker><view class="muted">沿用原版低 / 中 / 高三级，由检查人依据项目标准判定。</view>
   <view class="label">现场照片（{{issuePhotos.length}} / 9）</view>
   <view class="actions"><button bindtap="photo" data-target="issue" data-source="camera" disabled="{{busy||recording}}">拍摄照片</button><button class="secondary" bindtap="photo" data-target="issue" data-source="album" disabled="{{busy||recording}}">从相册选择</button></view>
   <view class="photos"><view class="photo" wx:for="{{issuePhotos}}" wx:key="id"><image src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="previewPhoto"/><button class="remove small" data-id="{{item.id}}" bindtap="removeIssuePhoto" disabled="{{busy}}">移除</button></view></view><view wx:if="{{!issuePhotos.length}}" class="photo-empty">拍照后在这里查看照片，点击缩略图可放大。</view>
   <view class="label">规范依据</view><textarea maxlength="4000" placeholder="填写已核实的规范名称和条款（可选）" value="{{issue.reference}}" data-key="issue.reference" bindinput="input"/>
   <view class="label">处理建议</view><textarea maxlength="4000" placeholder="填写现场处理或整改建议（可选）" value="{{issue.suggestion}}" data-key="issue.suggestion" bindinput="input"/>
   <view class="note">现场端记录隐患与建议；整改责任人、期限和复核由网页平台安排。</view>
   <button class="actions" bindtap="addIssue" disabled="{{busy||recording}}">保存本条隐患，继续登记</button>
  </view>
  <view id="brief-form" class="card"><view class="h2">现场简报与上报</view><view class="muted">至少保存一条隐患记录后才能生成简报。</view><block wx:if="{{canCollect&&canSubmit}}"><textarea maxlength="4000" placeholder="现场检查摘要或补充说明" value="{{note}}" data-key="note" bindinput="input"/><view class="label">检查人员名单 *</view><input maxlength="1000" value="{{inspectors}}" data-key="inspectors" bindinput="input" placeholder="多人用逗号或顿号分隔"/><view class="label">签名人姓名 *</view><input maxlength="100" value="{{signer}}" data-key="signer" bindinput="input" placeholder="由名单中的一位检查人签名确认"/><view class="label">检查完成确认签名 *</view><canvas class="signature" canvas-id="fieldSignature" disable-scroll="true" bindtouchstart="signStart" catchtouchmove="signMove" bindtouchend="signEnd"/><button class="secondary small" bindtap="clearSign" disabled="{{busy}}">清除重签</button><view class="muted">请本人核对记录后签名。上报后签名随本次简报保存。</view><button bindtap="submitField" disabled="{{busy||recording}}">生成简报并上报网页平台</button></block><view class="note">简报是现场材料，不替代平台审核后的正式报告。上报后记录锁定，平台退回时可追加补充。</view><view class="record" wx:for="{{task.fieldBriefs}}" wx:key="id"><view>现场简报 v{{item.version}} · {{item.createdAt}}</view><view class="actions"><button class="small" data-id="{{item.id}}" bindtap="showBrief">查看简报</button><button class="small secondary" data-id="{{item.id}}" bindtap="briefWord">Word预览／分享</button></view></view></view>
  <view class="card"><view class="h2">知识辅助查询</view><input placeholder="输入现场问题" value="{{question}}" data-key="question" bindinput="input"/><button class="secondary" bindtap="knowledge" disabled="{{busy}}">查询知识</button><view wx:if="{{knowledge}}"><view class="note">{{knowledge.message}}</view><view wx:for="{{knowledge.items}}" wx:key="title" class="record"><view>{{item.title}}</view><view>{{item.text}}</view><view class="muted">{{item.reference}}</view></view></view></view>
 </block>
</view>
