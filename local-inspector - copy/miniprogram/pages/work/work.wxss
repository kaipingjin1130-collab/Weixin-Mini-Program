.card{overflow:hidden}.card input,.card textarea,.card picker{margin:16rpx 0}.card textarea{width:100%;box-sizing:border-box;background:#f5f8f5;padding:16rpx;border:1px solid #d7e0d7;border-radius:12rpx}.member{padding:12rpx 0;border-bottom:1px solid #eee}.record{padding:20rpx 0;border-top:1px solid #ddd;white-space:pre-wrap}.actions{display:flex;gap:12rpx;flex-wrap:wrap}.actions button{margin:8rpx 0}checkbox-group label{display:block;padding:12rpx 0}.h2{margin-top:16rpx}.smalltext{font-size:24rpx;overflow-wrap:anywhere}.warning{color:#ad5823}.picker{padding:18rpx;background:#f2f6f2;border-radius:10rpx}.page{padding-bottom:60rpx}.evidence{padding:16rpx;border-bottom:1px solid #ddd}

.field-nav{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}.issue-card{border-top:6rpx solid #196b51}.risk-0{color:#196b51;background:#edf6ed}.risk-1{color:#956317;background:#fff5df}.risk-2{color:#b7352b;background:#fff0ed}.photo-empty{border:2rpx dashed #d5e0d4;border-radius:12rpx;padding:26rpx;color:#77877a;font-size:24rpx;margin-top:18rpx}.photo .remove{font-size:22rpx}.issue-card .actions{display:flex;flex-wrap:wrap}
