{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-package",
  "x-contract-status": "proposed",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "package_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "exported_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "org_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "scene_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "task": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "cancelled",
            "archived"
          ]
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "status",
        "started_at",
        "completed_at"
      ],
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "actor_id",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "occurred_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "format": "date-time",
                "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "actor_role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "related_object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "payload": {
            "type": "object",
            "maxProperties": 64,
            "additionalProperties": true
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          }
        },
        "required": [
          "event_id",
          "event_type",
          "occurred_at",
          "actor_id",
          "actor_role",
          "related_object_id",
          "payload",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "rectifying",
              "pending_review",
              "closed",
              "unknown"
            ]
          },
          "responsible_actor_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "due_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "format": "date-time",
                "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rectification": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              {
                "type": "null"
              }
            ]
          },
          "review_conclusion": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          }
        },
        "required": [
          "issue_id",
          "description",
          "status",
          "responsible_actor_id",
          "due_at",
          "rectification",
          "review_conclusion",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2000
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attachment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "mime_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 104857600
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "site_photo",
              "text_screenshot",
              "source_document",
              "video",
              "other",
              "unknown"
            ]
          },
          "access_ref": {
            "type": "object",
            "properties": {
              "connector_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "object_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              }
            },
            "required": [
              "connector_id",
              "object_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "attachment_id",
          "sha256",
          "mime_type",
          "size",
          "evidence_type",
          "access_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "data_completeness": {
      "type": "object",
      "properties": {
        "participants": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "missing",
            "not_applicable"
          ]
        },
        "events": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "missing",
            "not_applicable"
          ]
        },
        "issues": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "missing",
            "not_applicable"
          ]
        },
        "attachments": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "missing",
            "not_applicable"
          ]
        },
        "event_times": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "missing",
            "not_applicable"
          ]
        }
      },
      "required": [
        "participants",
        "events",
        "issues",
        "attachments",
        "event_times"
      ],
      "additionalProperties": false
    },
    "is_demo": {
      "type": "boolean"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.]*$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "producer",
    "package_id",
    "task_id",
    "package_version",
    "exported_at",
    "project_id",
    "org_id",
    "scene_code",
    "task",
    "participants",
    "events",
    "issues",
    "attachments",
    "data_completeness",
    "is_demo"
  ],
  "additionalProperties": false
}
