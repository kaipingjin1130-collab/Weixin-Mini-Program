{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-response",
  "x-contract-status": "proposed",
  "type": "object",
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "answered",
        "insufficient_evidence",
        "degraded"
      ]
    },
    "knowledge_release_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "answer_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "citation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "text",
          "citation_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkpoint_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "citation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "checkpoint_id",
          "text",
          "citation_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "knowledge_revision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "citation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "knowledge_revision_id",
          "title",
          "summary",
          "citation_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 20
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "citation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "knowledge_revision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "format": "uuid"
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36,
            "format": "uuid"
          },
          "source_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "locator": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "table": {
                "type": "integer",
                "minimum": 1
              },
              "row": {
                "type": "integer",
                "minimum": 1
              },
              "cell": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "event_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "source_record_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "section": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [],
            "additionalProperties": false,
            "minProperties": 1
          },
          "review_status": {
            "type": "string",
            "enum": [
              "approved",
              "published"
            ]
          }
        },
        "required": [
          "citation_id",
          "knowledge_revision_id",
          "evidence_id",
          "source_title",
          "locator",
          "review_status"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "missing_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 100,
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 0,
            "maxLength": 512
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "code",
          "path",
          "message"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "query_id",
    "status",
    "knowledge_release_id",
    "answer_blocks",
    "checkpoints",
    "cases",
    "citations",
    "missing_conditions",
    "warnings"
  ],
  "additionalProperties": false
}
