{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "withdraw-response",
  "x-contract-status": "proposed",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid"
    },
    "status": {
      "const": "withdrawn"
    },
    "withdrawn_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "replayed": {
      "type": "boolean"
    }
  },
  "required": [
    "receipt_id",
    "status",
    "withdrawn_at",
    "replayed"
  ],
  "additionalProperties": false
}
