{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge-query",
  "x-contract-status": "proposed",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scene_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "context": {
      "type": "object",
      "properties": {
        "object_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "stage": {
          "type": "string",
          "enum": [
            "preparation",
            "execution",
            "review",
            "training"
          ]
        },
        "conditions": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 2000
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "required": [
        "object_type",
        "stage",
        "conditions"
      ],
      "additionalProperties": false
    },
    "output_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "answer",
          "checkpoints",
          "cases"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.]*$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "request_id",
    "project_id",
    "scene_code",
    "question",
    "context",
    "output_types",
    "limit"
  ],
  "additionalProperties": false
}
