# Copy to a protected environment file outside the repository; fill real values.
# One API process + one durable worker. PostgreSQL needs the vector extension.
B_ENV=production
B_AUTH_MODE=a
QAXC_PORT=18765
QAXC_ROOT_PATH=/quality
QAXC_DATA=/var/lib/qaxc-platform/workflow
B_STORAGE=/var/lib/qaxc-platform/knowledge
B_DATABASE_URL=postgresql+psycopg://qaxc_platform:REPLACE@127.0.0.1:55440/qaxc_platform
QAXC_AUTH_URL=http://127.0.0.1/REPLACE_PRIVATE_IDENTITY_ENDPOINT
QAXC_AUTH_KEY=REPLACE_HOST_IDENTITY_KEY
A_ORG_ID=qaxc
A_TO_B_KEY=REPLACE_UNIQUE_RANDOM_KEY_1
B_TO_A_KEY=REPLACE_DIFFERENT_RANDOM_KEY_2
# Leave A_INTERNAL_BASE and QAXC_B_URL unset: run_platform derives same-process URLs.
