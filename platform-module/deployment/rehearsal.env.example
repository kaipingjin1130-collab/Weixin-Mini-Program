# ISOLATED REHEARSAL ONLY. Never copy over the production environment.
# Create a fresh empty database first; store real credentials outside Git.
QAXC_DB_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:55440/qaxc_rehearsal_REPLACE_ID
QAXC_DB_SCHEMA=a
B_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:55440/qaxc_rehearsal_REPLACE_ID
B_DATABASE_SCHEMA=b
# Use copied attachment directories, never live production storage.
QAXC_DATA=/REPLACE_ISOLATED_REHEARSAL_A_DATA
B_STORAGE=/REPLACE_ISOLATED_REHEARSAL_B_STORAGE
# Keep one API process; shared durable sessions are not implemented in this stage.
# Other identity/worker/service keys need isolated settings and explicit project scopes.
# No production cutover is authorized by this example.
