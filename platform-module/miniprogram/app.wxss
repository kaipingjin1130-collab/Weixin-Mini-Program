page{background:#f4f7f2;color:#193b30;font-size:28rpx;line-height:1.6}button{background:#196b51;color:white;font-size:28rpx;border-radius:12rpx;margin:0;padding:8rpx 24rpx}button::after{border:0}input,textarea,picker{background:#fafcf9;border:1rpx solid #d5e0d4;border-radius:10rpx;padding:18rpx;margin:10rpx 0;box-sizing:border-box}textarea{width:100%;height:160rpx}input{height:82rpx}.page{padding:30rpx 28rpx 170rpx}.card{background:white;border:1rpx solid #dfe8dc;border-radius:20rpx;padding:28rpx;margin-top:24rpx}.title{font-size:44rpx;font-weight:600;margin-bottom:14rpx}.h2{font-size:34rpx;font-weight:600}.muted{font-size:24rpx;color:#77877a}.row{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}.between{justify-content:space-between}.secondary{background:#eaf1e7;color:#235b42}.danger{background:#fff0eb;color:#a74f38}.small{font-size:24rpx;padding:4rpx 16rpx}.label{font-size:25rpx;color:#637965;margin-top:20rpx}.hero{background:#e1ebd9;border-radius:22rpx;padding:36rpx;margin-top:30rpx}.hero .h2{font-size:44rpx}.hero button{margin-top:30rpx}.stats{display:flex;gap:14rpx;margin-top:22rpx}.stat{flex:1;background:white;padding:22rpx;border:1rpx solid #dfe8dc;border-radius:16rpx}.number{font-size:48rpx}.tag{font-size:22rpx;color:#42714b;background:#edf3e8;border-radius:6rpx;padding:5rpx 12rpx}.nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1rpx solid #d6e3d4;padding:10rpx 0 calc(10rpx + env(safe-area-inset-bottom));z-index:5}.nav view{flex:1;text-align:center;font-size:23rpx;color:#7b8e7e;padding:12rpx 0}.nav .active{color:#196b51;font-weight:bold}.nav .symbol{display:block;font-size:34rpx;padding:0}.photos{display:flex;gap:14rpx;flex-wrap:wrap;margin:16rpx 0}.photo{position:relative}.photo image{width:180rpx;height:160rpx;border-radius:10rpx}.photo .remove{position:absolute;right:0;top:0;background:#fff;color:#a44a32;padding:0 12rpx}.signature{width:100%;height:280rpx;background:#fafcf9;border:1rpx dashed #8caa8a;margin:16rpx 0;touch-action:none}.reportimage{width:100%;margin:16rpx 0}.note{background:#fff5df;padding:20rpx;border-radius:12rpx;color:#8b703c;font-size:24rpx;margin-top:20rpx}.empty{text-align:center;color:#7b8b7d;padding:60rpx 15rpx}.actions{margin-top:24rpx}.text{white-space:pre-wrap;word-break:break-all}.divider{border-bottom:1rpx solid #e4ebe0;padding:20rpx 0}.login{padding-top:100rpx}.brand{background:#174b3a;color:#fff;border-radius:22rpx;width:90rpx;height:90rpx;display:flex;align-items:center;justify-content:center;font-size:50rpx;margin-bottom:28rpx}.saved{margin:18rpx 0;color:#748975;font-size:23rpx}

/* Comfortable touch targets on phones. */
button,button.small,.small{min-height:88rpx;line-height:1.5;padding:20rpx 28rpx;font-size:30rpx;border-radius:16rpx;box-sizing:border-box;}
input,.picker{min-height:88rpx;box-sizing:border-box;}
.actions{display:flex;flex-wrap:wrap;gap:20rpx;}
.actions button{flex:1;min-width:220rpx;margin:0;}
.page{padding-bottom:calc(36rpx + env(safe-area-inset-bottom));}
