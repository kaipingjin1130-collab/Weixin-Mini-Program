<view class="page">
 <view class="title">巡查任务工作台</view><view class="muted">{{user.name}}</view>
 <button class="secondary small" bindtap="switchAccount" disabled="{{busy}}">退出登录 / 切换账号</button>
 <view class="steps"><view class="step" wx:for="{{stageNames}}" wx:key="*this">{{item}}</view></view>
 <view class="tabs"><button data-tab="tasks" bindtap="tab">任务</button><button data-tab="stats" bindtap="tab">工作统计</button><button data-tab="staffing" bindtap="tab">项目用工</button><button data-tab="messages" bindtap="tab">提醒 {{unread||0}}</button></view>
 <view wx:if="{{message}}" class="warn">{{message}}</view><view wx:if="{{busy}}" class="note">正在处理…</view>
 <button class="secondary small actions" bindtap="reload" disabled="{{busy}}">刷新</button>
 <button class="secondary actions" bindtap="reportList" disabled="{{busy}}">报告查看 / 签字 / 发布</button>
 <block wx:if="{{tab==='tasks'}}">
  <view class="note" wx:if="{{!creating&&!task}}"><view wx:for="{{projectAccess}}" wx:key="id"><view>{{item.name}} · 当前角色：{{item.roleName}}</view><view wx:if="{{item.canDispatch}}">你可在此项目填写工地信息并派发任务。</view><view wx:else>当前角色没有派单权限。请由{{item.dispatchers||'该项目的项目经理'}}本人登录派单；收到邀请后，本人接单并进行现场检查。</view></view><view wx:if="{{!projects.length}}">当前账号尚未分配项目，请联系项目管理员核对权限。</view></view>
  <block wx:if="{{creating}}"><button class="secondary" bindtap="back">返回</button><view class="card"><view class="h2">工地信息填写 / 任务派发</view>
   <picker range="{{projects}}" range-key="name" value="{{projectIndex}}" data-key="projectIndex" bindchange="pick"><view class="picker">项目：{{projects[projectIndex].name}} ▾</view></picker>
   <view class="input-row">任务名称<input value="{{form.title}}" maxlength="200" data-key="form.title" bindinput="input"/></view><view class="input-row">具体工地 / 地址<input value="{{form.site}}" maxlength="300" data-key="form.site" bindinput="input"/></view>
   <picker mode="date" value="{{form.workDate}}" data-key="form.workDate" bindchange="input"><view class="picker">工作日期：{{form.workDate}} ▾</view></picker><view class="input-row">需求人数（人）<input type="number" value="{{form.requiredPeople}}" data-key="form.requiredPeople" bindinput="input"/></view>
   <picker range="{{leaders}}" range-key="name" value="{{leaderIndex}}" data-key="leaderIndex" bindchange="pick"><view class="picker">组长：{{leaders[leaderIndex].name}} ▾</view></picker>
   <view class="label">邀请接单人员（组长参与检查时也须接单）</view><checkbox-group data-key="invitedIds" bindchange="checks"><label class="choice" wx:for="{{members}}" wx:key="id"><checkbox value="{{item.id}}"/>{{item.name}}</label></checkbox-group>
   <button bindtap="create" disabled="{{busy||!projectCanManage}}">发布任务并提醒接单</button></view></block>
  <block wx:elif="{{task}}"><button class="secondary" bindtap="back">返回任务列表</button><view class="card"><view class="state">{{task.stageName}}</view><view class="h2">{{task.title}}</view><view>{{task.site}} · {{task.workDate}}</view><view>需求 {{task.requiredPeople}} 人 / 已接单 {{task.acceptedIds.length}} 人 / 已确认 {{task.confirmedIds.length}} 人</view><view>最终名单：{{task.confirmedNames||'待确认'}}</view><view class="warn" wx:if="{{task.overContract}}">本次需求人数多于合同每次要求人数，请核对合同及安排。</view><view class="muted">老平台同步：{{task.syncStatus||'pending'}} {{task.syncMessage||''}}</view><view wx:if="{{task.returnReason}}" class="warn">退回原因：{{task.returnReason}}</view></view>
   <view class="card" wx:if="{{task.stage==='dispatch'}}"><button wx:if="{{task.canAccept}}" bindtap="accept" disabled="{{busy}}">本人接单</button><block wx:if="{{task.canManage}}"><view class="h2">确认最终名单</view><checkbox-group data-key="confirmedIds" bindchange="checks"><label class="choice" wx:for="{{acceptedPeople}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}"/>{{item.name}}</label></checkbox-group><textarea placeholder="人数与需求不一致时填写原因" value="{{reason}}" data-key="reason" bindinput="input"/><button bindtap="roster" disabled="{{busy||!acceptedPeople.length}}">组长 / 项目经理确认名单</button></block><view class="muted">只有本人接单的人员可被纳入最终名单。</view></view>
   <view class="card" wx:if="{{task.stage==='inspection'}}"><view class="h2">现场检查 · 草稿箱</view><view>已保存 {{task.issues.length}} 条隐患、{{task.records.length}} 条现场记录</view><button bindtap="field">现场录入 / 查看草稿及照片</button><textarea placeholder="检查范围和结论" value="{{note}}" data-key="note" bindinput="input"/><label><switch checked="{{noHazard}}" bindchange="noHazard"/>本次未发现隐患</label><button bindtap="complete" disabled="{{busy}}">检查完成，交组长筛选</button></view>
   <view class="card" wx:if="{{task.stage==='review'}}"><view class="h2">组长筛选确定清单</view><view class="muted">所选记录进入报告；未选记录仍保留，不删除原始草稿。</view><checkbox-group data-key="selectedIds" bindchange="checks"><label class="choice" wx:for="{{draftItems}}" wx:key="id"><checkbox value="{{item.id}}" disabled="{{!task.canManage}}"/>{{item.kind}}：{{item.text}}</label></checkbox-group><button class="secondary" bindtap="field">查看完整草稿及证据照片</button><block wx:if="{{task.canManage}}"><textarea placeholder="排除记录或退回时填写理由" value="{{reason}}" data-key="reason" bindinput="input"/><textarea placeholder="检查结论（空清单必填）" value="{{note}}" data-key="note" bindinput="input"/><label><switch checked="{{noHazard}}" bindchange="noHazard"/>无隐患清单</label><button bindtap="select" disabled="{{busy}}">确定清单并生成待签报告</button><button class="secondary" bindtap="returnDraft" disabled="{{busy}}">退回补充检查</button></block></view>
   <view class="card" wx:if="{{task.combinedId}}"><view class="h2">报告生成 / 签字确认</view><button bindtap="report">核对报告、各方签字 / Word预览</button><button wx:if="{{task.stage==='signing'&&task.canManage}}" bindtap="publish" disabled="{{busy}}">全部签字后确认发布</button><view class="muted">检查名单全员、组长、被检查人均须签字；发布后签名和报告内容锁定。</view></view>
   <view class="card" wx:if="{{task.stage==='published'&&task.canManage}}"><view class="h2">工作认定</view><checkbox-group data-key="actualIds" bindchange="checks"><label class="choice" wx:for="{{actualPeople}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}"/>{{item.name}}</label></checkbox-group><view class="input-row">每人实际工时<input type="digit" value="{{hours}}" data-key="hours" bindinput="input"/></view><textarea placeholder="认定依据 / 说明（必填）" value="{{note}}" data-key="note" bindinput="input"/><button bindtap="recognize" disabled="{{busy}}">确认实际工作量</button></view>
   <view class="card" wx:if="{{task.recognition}}"><view class="h2">工作已认定</view><view>{{task.recognition.actualIds.length}} 人次 · 每人 {{task.recognition.hoursPerPerson}} 小时</view><view>{{task.recognition.note}}</view><view class="muted">{{task.recognition.at}}</view></view>
  </block>
  <block wx:else><button wx:if="{{canCreate}}" bindtap="createView">＋ 工地信息填写 / 派发任务</button><view class="card" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="state">{{item.stageName}}</view><view class="h2">{{item.title}}</view><view>{{item.site}} · {{item.workDate}}</view><view>需求 {{item.requiredPeople}} 人 · 接单 {{item.acceptedIds.length}} 人 · 最终 {{item.confirmedIds.length}} 人</view><view wx:if="{{item.overContract}}" class="warn">需求人数超合同要求</view></view><view class="empty" wx:if="{{!tasks.length}}">暂无新流程任务</view><button class="secondary" bindtap="history">历史任务 / 离线草稿</button></block>
 </block>
 <block wx:if="{{tab==='stats'||tab==='staffing'}}"><view class="card"><view class="date-range"><picker mode="date" data-key="from" value="{{from}}" bindchange="input"><view class="picker">{{from||'开始日期'}} ▾</view></picker><picker mode="date" data-key="to" value="{{to}}" bindchange="input"><view class="picker">{{to||'结束日期'}} ▾</view></picker></view><button class="secondary" bindtap="reload">按日期查询</button></view></block>
 <block wx:if="{{tab==='stats'}}"><button class="secondary" bindtap="legacyStats" disabled="{{busy}}">读取老平台工作量统计</button><view class="card" wx:if="{{legacy}}"><view class="h2">老平台核定工作量：{{legacy.total_person_workload}}</view><view>{{legacy.scope_note}}</view><view class="muted">{{legacy.counting_rule}}</view><view wx:for="{{legacy.people}}" wx:key="person_id">{{item.person_name}}：{{item.workload}}</view></view><view class="tabs"><button data-scope="self" bindtap="statsScope">我的统计</button><button wx:if="{{canViewAll}}" data-scope="all" bindtap="statsScope">全部人员</button></view><view class="note">以任务工作日期统计新流程任务。接单、最终名单、发布和工作认定分别计数；一人参加同一任务只计一次。历史平台计量不与新任务重复累加。</view><view class="card" wx:for="{{statistics}}" wx:key="id"><view class="h2">{{item.name}}</view><view>已接单 {{item.accepted}} · 名单确认 {{item.confirmed}} · 报告发布 {{item.published}}</view><view class="metric">工作认定 {{item.recognized}} 人次 / {{item.hours}} 小时</view><view class="muted">实际工作日期 {{item.workDays}} 天</view></view></block>
 <block wx:if="{{tab==='staffing'}}"><view class="note">合同配置按“每次巡查人数”比较。累计需求、确认和实际量的单位是人次，实际人数按人员去重。</view><view class="card" wx:for="{{projectStatistics}}" wx:key="id"><view class="h2">{{item.name}}</view><view>{{item.contract}}</view><view>合同每次要求：{{item.config.contractPeople===undefined?'未配置':item.config.contractPeople+' 人'}}</view><view>累计需求 {{item.demand}} 人次 / 确认 {{item.confirmed}} 人次</view><view>实际 {{item.actual}} 人次 / 去重 {{item.distinctPeople}} 人</view><view>单次最大需求 {{item.maxDemand}} 人</view><view class="warn" wx:if="{{item.overTasks}}">{{item.overTasks}} 项任务需求人数超过合同要求</view></view><view class="card"><view class="h2">合同人数与老平台关联</view><picker range="{{projects}}" range-key="name" value="{{projectIndex}}" data-key="projectIndex" bindchange="pick"><view class="picker">{{projects[projectIndex].name}} ▾</view></picker><block wx:if="{{projectCanManage}}"><view class="input-row">合同每次要求人数<input type="number" value="{{contractPeople}}" data-key="contractPeople" bindinput="input"/></view><textarea placeholder="合同条款 / 核对依据（必填）" value="{{basis}}" data-key="basis" bindinput="input"/><view class="input-row">老平台合同目录ID（互通时填写）<input type="number" value="{{catalogId}}" data-key="catalogId" bindinput="input"/></view><button bindtap="saveConfig" disabled="{{busy||contractPeople===''}}">保存合同配置</button></block><view wx:else class="muted">由项目经理维护合同要求。</view></view></block>
 <block wx:if="{{tab==='messages'}}"><button bindtap="subscribe" disabled="{{busy}}">订阅微信任务提醒</button><view class="muted">微信服务通知需本人授权和后台配置；站内提醒保留，点击可标记已读并打开任务。</view><view class="card" wx:for="{{notifications}}" wx:key="id" data-id="{{item.id}}" data-task="{{item.taskId}}" bindtap="read"><view>{{item.readAt?'已读':'未读'}} · {{item.text}}</view><view class="muted">{{item.createdAt}}</view></view><view wx:if="{{!notifications.length}}" class="empty">暂无任务提醒</view></block>
</view>
