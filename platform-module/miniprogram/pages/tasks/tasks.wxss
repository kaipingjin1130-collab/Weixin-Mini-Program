@import "../work/work.wxss";
.steps{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.step{background:#e6f0eb;padding:12rpx;border-radius:10rpx;font-size:24rpx}.tabs{display:flex;flex-wrap:wrap;gap:8rpx}.tabs button{flex:1;min-width:140rpx;font-size:26rpx}.metric{font-size:30rpx;font-weight:600;color:#164b3b;margin:16rpx 0}.warn{background:#fff0d0;color:#805000;padding:20rpx;border-radius:12rpx}.choice{display:block;padding:18rpx 0;border-bottom:1rpx solid #e4e9e5}.state{color:#164b3b;font-weight:600}.input-row{margin:18rpx 0}.input-row input{background:#f3f6f3;padding:20rpx;border-radius:8rpx}.date-range{display:flex;gap:16rpx}.date-range picker{flex:1}.break{word-break:break-all}

.applicant-row{display:flex;align-items:center;gap:16rpx;border-bottom:1rpx solid #e4e9e5}.applicant-row .choice{flex:1;min-width:0;border-bottom:0}.applicant-row button{flex-shrink:0;margin:0;font-size:24rpx}
