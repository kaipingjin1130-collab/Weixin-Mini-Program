<view class="page">
 <button class="secondary actions" bindtap="openOffline">离线采集／手机草稿／回办公室同步</button>
 <view wx:if="{{mode==='login'}}" class="login">
  <view wx:if="{{identityUat}}" class="note">本机验收 · 请用本人原平台账号登录。密码不记忆，任务和签字只保存到本机验收库。</view>
  <view class="brand">察</view><view class="title">质量安全小察</view><view class="muted">{{identityUat?'本机验收 · 巡查工作台':'云端协同 · 巡查工作台'}}</view>
  <view class="card"><view class="label">登录账号</view><input value="{{username}}" data-key="username" bindinput="input" placeholder="请输入原平台账号"/><view class="label">访问密码</view><input password value="{{password}}" data-key="password" bindinput="input" placeholder="请输入与网页平台相同的密码"/><button loading="{{busy}}" disabled="{{busy}}" bindtap="login">登录</button><button class="secondary" bindtap="forgetAccount">清除记住的账号密码</button></view>
  <view wx:if="{{!identityUat}}" class="note">使用与网页平台相同的账号和密码登录，两端数据实时同步。登录后可查看全平台发布的巡查任务并自主报名。</view>
 </view>
 <block wx:else>
  <view class="title">质量安全小察 · 现场端</view>
  <view class="card"><view class="h2">现场任务与记录</view><view class="muted">工地信息与派单、本人接单、现场草稿、组长筛选、各方签字发布及工作认定。</view><button class="actions" bindtap="openWork">进入巡查任务工作台 →</button></view>
  <button class="actions" bindtap="openTemporary">临时巡查 · 无需派单，直接开始</button><view class="note">全平台任务开放报名，最终名单由任务负责人确认。临时巡查可本人直接开始。</view>
  <button class="secondary actions" bindtap="logout" disabled="{{busy}}">退出登录／切换账号</button>
 </block>
</view>

<canvas type="2d" id="imageImportCanvas" style="position:fixed;left:-9999px;top:0;width:1px;height:1px;pointer-events:none"/>
